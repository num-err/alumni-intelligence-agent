# Anthropic Claude API key (used for evidence reasoning, never for search)
CLAUDE_API_KEY=

# Tavily Search API key (used for all web search operations)
TAVILY_API_KEY=

# Hunter.io API key (used to find/verify a replacement email when the known
# one is missing or at the stale email domain)
HUNTER_API_KEY=

# Institution identity: shown to Claude for identity verification and used
# in search queries.
INSTITUTION_NAME=Example University
# Addresses at this domain are treated as stale (alongside a missing email)
# and become eligible for replacement. Leave blank to only replace missing
# emails.
STALE_EMAIL_DOMAIN=example.edu

# Number of concurrent enrichment workers
WORKER_COUNT=5

# Confidence threshold (0-100). Rows scoring below this go to the review queue.
CONFIDENCE_THRESHOLD=80

# Number of retries for failed API calls (search + Claude), with exponential backoff
RETRY_COUNT=3

# Number of days before a cached search/Claude response expires
CACHE_EXPIRATION_DAYS=30

# Directories (relative to project root unless absolute)
UPLOAD_DIR=uploads
OUTPUT_DIR=output
CACHE_DIR=cache
LOG_DIR=logs

# SQLite database location
DATABASE_URL=sqlite:///./cache/alumni_agent.db
